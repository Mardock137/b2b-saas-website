# ============================================================
# Acme Labs Website - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
# URL base del sito. Obbligatoria su Vercel (staging e produzione):
# se manca, signup, checkout e billing portal vanno in errore.
# In locale può restare su localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
# In locale usa le chiavi del progetto Supabase "staging" (staging + sviluppo),
# condiviso con Frontline: le tabelle del sito vivono nello schema
# dedicato "website" (vedi src/lib/supabase/*.ts), quelle di Frontline nello
# schema "frontline". Il progetto "prod" è riservato alla produzione (scope
# Production su Vercel).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------
# STRIPE
# ------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ------------------------------------------------------------
# RESEND
# ------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key
CONTACT_RECIPIENT_EMAIL=support@example.com

# ------------------------------------------------------------
# SSO / FRONTLINE
# ------------------------------------------------------------
# Secret condiviso con Frontline per firmare il JWT di accesso.
# Deve essere identico su questo sito e su Frontline.
SSO_SHARED_SECRET=your_sso_shared_secret

# ------------------------------------------------------------
# ANTI-BOT (Cloudflare Turnstile + Upstash)
# ------------------------------------------------------------
# In locale, senza widget reale, usa le chiavi di test ufficiali Cloudflare
# che fanno sempre passare la verifica:
#   site key  1x00000000000000000000AA
#   secret    1x0000000000000000000000000000000AA
# Su Vercel: NEXT_PUBLIC_TURNSTILE_SITE_KEY è Config, TURNSTILE_SECRET_KEY
# è Sensitive (Production e Preview).
# KV_REST_API_URL e KV_REST_API_TOKEN le inietta il collegamento Upstash
# (database ratelimit). In locale, se mancano, il rate limit
# del form contatti viene saltato; Turnstile resta attivo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
